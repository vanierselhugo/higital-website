# Copy to .env and enter a Resend API key. Never commit the real key.
RESEND_API_KEY=

# A sender address on a domain verified in your Resend account.
HIGITAL_FROM_EMAIL=

# Optional: set only when your trusted hosting proxy overwrites this header.
# Supported values: x-real-ip, cf-connecting-ip, x-forwarded-for
# HIGITAL_CLIENT_IP_HEADER=
